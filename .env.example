# Required
DISCORD_TOKEN=your-bot-token-here
CHANNEL_ID=123456789012345678

# Optional (defaults shown)
# DB_PATH=jobs.db
# MAX_PER_CYCLE=25            # jobs per category, per hourly run
# EE_REQUIRE_LOCATION=true     # false = electrical/hardware interns from anywhere
# IE_REQUIRE_LOCATION=true     # false = IE interns from anywhere (default: Atlanta/NY/Hybrid/Remote)
# SEED_ON_FIRST_RUN=true
# ENABLE_JOBSPY=true
# JOBSPY_RESULTS=25
# JOBSPY_HOURS_OLD=72
# PROXIES=user:pass@host1:port,user:pass@host2:port
